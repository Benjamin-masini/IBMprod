# REMOVED SENSITIVE VALUE - rotate your secrets immediately
# This .env file no longer contains real secrets. Fill values from a secure secret manager or local environment.

# =========================================
# APP
# =========================================
PORT=5000
NODE_ENV=development

# =========================================
# DATABASE
# =========================================
MONGO_URI=

# =========================================
# JWT AUTH
# =========================================
JWT_SECRET=
JWT_EXPIRES_IN=7d

# =========================================
# STRIPE PAYMENTS
# =========================================
STRIPE_SECRET_KEY=

# =========================================
# SOCKET.IO
# =========================================
CLIENT_URL=http://localhost:3000

# =========================================
# CLOUDINARY (future uploads cloud)
# =========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =========================================
# EMAIL (future notifications/reset password)
# =========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# =========================================
# FILE UPLOADS
# =========================================
MAX_FILE_SIZE=10485760

# =========================================
# ADMIN DEFAULT ACCOUNT (do NOT use in production)
# =========================================
ADMIN_EMAIL=admin@ibmprod.com
ADMIN_PASSWORD=
